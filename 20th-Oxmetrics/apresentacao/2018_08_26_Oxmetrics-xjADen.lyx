\begin_deeper
\begin_layout Standard
\begin_inset Formula 
\[
𝑥_{𝑖}𝑡=𝑎_{𝑖0}+𝑎_{𝑖1}𝑡+∑_{𝑗=1}^{𝑝_{𝑖}}\Phi_{ij}x_{i,t-j}+\Lambda_{𝑖0}𝑥_{𝑖t}^{*}+\sum_{l=1}^{qi}\Lambda_{il}x_{i,t-l}+𝑢_{𝑖t}
\]

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
x_{it}^{*}=\sum_{j=0}^{N}W_{ij}x_{jt}
\]

\end_inset

 
\begin_inset Formula 
\[
A_{i0}W_{i}x_{t}=a_{i0}+a_{i1}t+\sum_{l=1}^{p}A_{il}W_{i}x_{t-l}+\epsilon_{t}
\]

\end_inset


\end_layout

\end_deeper
\end_deeper
\begin_layout Standard
\begin_inset Separator parbreak
\end_inset


\end_layout

\begin_layout Frame
\begin_inset Argument 4
status open

\begin_layout Plain Layout
The Global VAR model as a two-step procedure
\end_layout

\end_inset


\begin_inset Separator latexpar
\end_inset


\end_layout

\begin_deeper
\begin_layout Itemize

\size small
Second Stage: The VAR models of each region are grouped into a single Global
 VAR model.
\end_layout

\begin_layout Itemize
\begin_inset Formula 
\[
G_{0}=\left[\begin{array}{c}
A_{00W_{0}}\\
A_{10W_{1}}\\
\vdots\\
A_{N0}W_{N}
\end{array}\right];\quad G_{l}=\left[\begin{array}{c}
A_{0lW_{0}}\\
A_{1lW_{1}}\\
\vdots\\
A_{Nl}W_{N}
\end{array}\right];\quad a_{0}=\left[\begin{array}{c}
a_{00}\\
a_{10}\\
\vdots\\
a_{N0}
\end{array}\right];\quad a_{1}=\left[\begin{array}{c}
a_{01}\\
a_{11}\\
\vdots\\
a_{N1}
\end{array}\right];\quad\epsilon_{1}=\left[\begin{array}{c}
\epsilon_{0t}\\
\epsilon_{1t}\\
\vdots\\
\epsilon_{Nt}
\end{array}\right];
\]

\end_inset


\end_layout

\begin_layout Itemize
\begin_inset Formula 
\[
G_{0}x_{t}=a_{0}+a_{1}t+\sum_{l=1}^{p}G_{l}x_{t-l}+\epsilon_{t}
\]

\end_inset


\end_layout

\begin_layout Itemize
\begin_inset Formula 
\[
𝐹_{𝑖}=𝐺_{0}^{−1}𝐺_{𝑖};\quad𝑏_{0}=𝐺_{0}^{−1}𝑎_{0};\quad𝑏_{1}=𝐺_{0}^{−1}𝑎_{1};\quad e_{𝑡}=𝐺_{0}^{−1}\epsilon_{𝑡};
\]

\end_inset


\end_layout

\begin_layout Itemize
\begin_inset Formula 
\[
x_{t}=b_{o}+b_{1}t+\sum F_{i}x_{t-i}+e_{t}
\]

\end_inset


\end_layout

\end_deeper
