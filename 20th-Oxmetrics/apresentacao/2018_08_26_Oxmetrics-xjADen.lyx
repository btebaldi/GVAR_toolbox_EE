\begin_layout Itemize
\begin_inset Formula 
\[
x_{it}=\left[\begin{array}{c}
Adm_{it}\\
Dis_{it}
\end{array}\right];\quad x_{it}^{*}=\left[\begin{array}{c}
Adm_{it}^{*}\\
Dis_{it}^{*}
\end{array}\right]
\]

\end_inset


