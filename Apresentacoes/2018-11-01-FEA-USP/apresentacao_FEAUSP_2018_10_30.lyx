\end_layout

\begin_deeper
\begin_layout Itemize

\size small
First stage: Specific models of each region are estimated conditioned on
 external influences from other regions.
\end_layout

\begin_deeper
\begin_layout Standard
\begin_inset Formula 
\begin{equation}
𝑥_{𝑖𝑡}=𝑎_{𝑖0}+𝑎_{𝑖1}𝑡+∑_{𝑗=1}^{𝑝_{𝑖}}\Phi_{ij}x_{i,t-j}+\Lambda_{𝑖0}𝑥_{𝑖t}^{*}+\sum_{l=1}^{qi}\Lambda_{il}\text{𝑥}_{\text{𝑖}t-l}^{*}+𝑢_{𝑖t}
\end{equation}

\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
x_{it}^{*}=\sum_{j=0}^{N}W_{ij}x_{jt}
\]

\end_inset


\end_layout

\end_deeper
\begin_layout Itemize
And they can be restated as:
\end_layout

\begin_deeper
\begin_layout Standard
\begin_inset Formula 
\begin{equation}
A_{i0}W_{i}x_{t}=a_{i0}+a_{i1}t+\sum_{l=1}^{p}A_{il}W_{i}x_{t-l}+\epsilon_{t}
\end{equation}

\end_inset


\end_layout

\end_deeper
\end_deeper
